# DeepSeek API (OpenAI-compatible)
# Base URL for the DeepSeek chat completions endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Your DeepSeek API key
DEEPSEEK_API_KEY=sk-your-key-here
# Model to use for fact extraction (chat/completions)
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Embeddings API (DeepSeek or another OpenAI-compatible provider)
# Base URL for the embeddings endpoint (may differ from chat)
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
# API key for the embeddings endpoint (may differ from chat)
EMBEDDING_API_KEY=sk-your-key-here
# Model to use for embeddings
EMBEDDING_MODEL=deepseek-embed

# Graph storage paths (relative to project root)
# Path to the human-readable graph file (JSON)
MEMORY_PATH=memory.json
# Path to the embedding sidecar file (JSON)
EMBEDDINGS_PATH=embeddings.json

# Thresholds for dedup and edge detection (cosine similarity, 0.0-1.0)
# Above this threshold, facts are considered duplicates and merged
DEDUP_THRESHOLD=0.92
# Above this threshold (but below DEDUP_THRESHOLD), a new node is created with an edge
EDGE_THRESHOLD=0.75

# Confidence model
# Initial confidence for a newly created fact node
CONFIDENCE_BASE=1.0
# Confidence added on each new-source corroboration
CONFIDENCE_INCREMENT=1.0
